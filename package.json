{
  "name": "loyverse-mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server for the Loyverse POS API.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "loyverse-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "bundle": "npm run build && node scripts/build-bundle.mjs && mcpb pack bundle loyverse.mcpb",
    "icon": "node scripts/make-icon.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "loyverse",
    "pos",
    "retail"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
